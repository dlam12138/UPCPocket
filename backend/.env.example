# Copy to a local .env and replace the secret-file paths with protected files outside this checkout.
POCKET_DB_NAME=pocket
POCKET_DB_USERNAME=pocket
PORT=8080
POCKET_DB_PASSWORD_SOURCE_FILE=/absolute/path/to/pocket-secrets/db-password
POCKET_VAULT_MASTER_KEYS_SOURCE_FILE=/absolute/path/to/pocket-secrets/master-keys
POCKET_VAULT_INITIAL_WRITE_KEY_VERSION=v1
POCKET_VAULT_LOGIN_INDEX_KEY_SOURCE_FILE=/absolute/path/to/pocket-secrets/login-index-key
POCKET_VAULT_AUDIT_INDEX_KEY_SOURCE_FILE=/absolute/path/to/pocket-secrets/audit-index-key
POCKET_ADMIN_JWT_JWK_SET_URI=https://issuer.example.invalid/.well-known/jwks.json
POCKET_ADMIN_JWT_ISSUER=https://issuer.example.invalid/
POCKET_ADMIN_JWT_AUDIENCE=upcpocket-admin
POCKET_CAS_ENABLED=false
POCKET_CAS_LOGIN_URL=
POCKET_CAS_SERVICE=
POCKET_CAS_CONNECT_TIMEOUT_MS=3000
POCKET_CAS_READ_TIMEOUT_MS=5000
