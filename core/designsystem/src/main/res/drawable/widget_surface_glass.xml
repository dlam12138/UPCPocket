<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface_glass" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_edge" />
        </shape>
    </item>
    <item
        android:height="2dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_highlight" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
