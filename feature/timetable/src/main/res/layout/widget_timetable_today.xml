<?xml version="1.0" encoding="utf-8"?>
<!--
  今日课表：2×2 为默认密度，4×2 才增加次课。主课先占空间，页脚/次课只使用
  剩余空间；任何尺寸下都不让主课标题被 weighted 区域压成一条碎片。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface">

    <LinearLayout
        android:id="@+id/widget_timetable_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_timetable_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingEnd="28dp"
                android:text="@string/widget_timetable_title"
                android:textColor="@color/widget_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_timetable_meta_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_timetable_bar"
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_timetable_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_timetable_preview_date"
                android:textColor="@color/widget_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_timetable_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_timetable_preview_status"
                android:textColor="@color/widget_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_timetable_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_timetable_course"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/widget_timetable_preview_course"
                android:textColor="@color/widget_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_timetable_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_timetable_preview_time"
                android:textColor="@color/widget_secondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/widget_timetable_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_timetable_preview_location"
                android:textColor="@color/widget_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_timetable_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_timetable_secondary_bar"
                android:layout_width="2dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_timetable_secondary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_timetable_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_timetable_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_timetable_preview_footer"
            android:textColor="@color/widget_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_timetable_refresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_refresh_touch"
        android:contentDescription="@string/widget_refresh_timetable"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_refresh" />
</FrameLayout>

