<?xml version="1.0" encoding="utf-8"?>
<!--
  今日课表：2×2 为单栏主课卡片；4×2 宽卡在右侧展开“后续课程”列表（最多再展示 2~3 节），
  主课与时间/地点始终不被压缩，所有状态均明确呈现。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface">

    <LinearLayout
        android:id="@+id/widget_timetable_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/widget_timetable_left_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.12"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_timetable_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_title"
                    android:textColor="@color/widget_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_timetable_bar"
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@color/widget_accent" />

                <TextView
                    android:id="@+id/widget_timetable_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_preview_date"
                    android:textColor="@color/widget_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_timetable_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_preview_status"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_timetable_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:text="@string/widget_timetable_preview_course"
                    android:textColor="@color/widget_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_timetable_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_preview_time"
                    android:textColor="@color/widget_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_timetable_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_preview_location"
                    android:textColor="@color/widget_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_timetable_secondary_bar"
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/widget_accent" />

                <TextView
                    android:id="@+id/widget_timetable_secondary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_timetable_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_timetable_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_timetable_preview_footer"
                android:textColor="@color/widget_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_timetable_side_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_timetable_side_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_timetable_upcoming_header"
                android:textColor="@color/widget_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/widget_timetable_upcoming_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_timetable_upcoming_bar_1"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/widget_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_name_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/widget_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_meta_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_upcoming_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_timetable_upcoming_bar_2"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/widget_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_name_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/widget_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_meta_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_upcoming_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_timetable_upcoming_bar_3"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/widget_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_name_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/widget_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/widget_timetable_upcoming_meta_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_timetable_upcoming_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_tertiary"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
