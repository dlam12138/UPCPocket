<?xml version="1.0" encoding="utf-8"?>
<!--
  今明课表：左列为上海实际今天，右列为次日；两列各自显示日期、节次和课程名。
  每列的超出行数用独立的“+N”视图标出，不挤占日期或课程；课程过窄时只在末尾
  省略名称，节次始终保留。账号/读取状态使用整卡状态块，绝不伪装成两天无课。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable_tt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface">

    <LinearLayout
        android:id="@+id/widget_timetable_tt_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_timetable_tt_columns"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_timetable_tt_today_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_timetable_tt_today_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_timetable_tt_today_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/widget_timetable_tt_today"
                        android:textColor="@color/widget_accent"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/widget_timetable_tt_today_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_secondary"
                        android:textSize="9.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_timetable_tt_today_course_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_tt_preview_course"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/widget_timetable_tt_today_course_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_timetable_tt_today_course_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_timetable_tt_tomorrow_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_timetable_tt_tomorrow_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_timetable_tt_tomorrow_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/widget_timetable_tt_tomorrow"
                        android:textColor="@color/widget_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/widget_timetable_tt_tomorrow_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_secondary"
                        android:textSize="9.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_timetable_tt_tomorrow_course_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_tt_preview_course"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/widget_timetable_tt_tomorrow_course_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_timetable_tt_tomorrow_course_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_primary"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_timetable_tt_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_timetable_tt_state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/widget_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_timetable_tt_state_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/widget_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>
</FrameLayout>
