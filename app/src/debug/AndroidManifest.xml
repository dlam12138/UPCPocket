<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only synthetic preview. It never reads account state or timetable cache. -->
        <receiver
            android:name=".debug.SyntheticTimetableWidgetProvider"
            android:exported="false"
            android:label="@string/widget_timetable_synthetic_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_synthetic_info" />
        </receiver>

        <receiver
            android:name=".debug.SyntheticTimetableWideWidgetProvider"
            android:exported="false"
            android:label="@string/widget_timetable_synthetic_wide_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_synthetic_wide_info" />
        </receiver>

        <activity
            android:name=".debug.SyntheticTimetableControlActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
