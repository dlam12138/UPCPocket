<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 用户主动查询：空闲教室（公开）、图书馆座位（官方 CAS 登录）、校园卡余额（官方登录）、
         唐岛湾宿舍剩余电量（公开的楼号＋房间号查询）。
         不接入自建认证代理，不保存账号密码，不做后台轮询；
         明文网络只在 res/xml/network_security_config.xml 里对已核实主机放开。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 番茄钟：倒计时通知 + 走完时的提醒。
         没有 POST_NOTIFICATIONS（Android 13+）时前台服务仍然能跑，但通知不可见。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        校园服务入口要在系统浏览器里打开，Android 11+ 必须显式声明可查询的 Intent。
        这里只声明 http/https 的浏览意图，查询范围最小。
    -->
    <queries>
        <!-- 仅用于用户主动选择的微信分享/启动，不查询全部安装应用。 -->
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
        系统备份：**关掉**。

        README 承诺"数据只在本机、不上传"，而系统云备份由**操作系统**代劳上传，
        完全不经过本应用的网络栈 —— 没有 INTERNET 权限也拦不住。
        所以这里两道保险：
          · android:allowBackup="false"
          · 两份规则文件里逐域排除（覆盖某些 ROM 忽略 allowBackup 的情况，
            以及 Android 11 及以下走 fullBackupContent 的路径）
    -->
    <application
        android:name=".UpcPocketApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpcPocket">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UpcPocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 轻量版已删除两个课表桌面组件（下一节课 / 今明课表）及其刷新闹钟。
             本应用不再声明任何 AppWidgetProvider，也不会出现在"小组件"选择页。 -->

        <!-- 番茄钟前台服务。计时本身不依赖它（时间用墙钟算），
             它的作用是不让系统回收进程 + 显示常驻倒计时通知。
             API 34+ 必须声明类型，番茄钟没有更贴切的类型，用 specialUse 并在下面说明用途。 -->
        <service
            android:name=".focus.PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro_timer" />
        </service>
    </application>

</manifest>
