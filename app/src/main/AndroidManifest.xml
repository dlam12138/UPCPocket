<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 用户主动查询：空闲教室（公开）、图书馆座位（官方 CAS 登录）、校园卡余额（官方登录）、
         课表（当前统一账号的正常 CAS 登录后只读查询）、唐岛湾宿舍剩余电量（公开的楼号＋房间号查询）。
         不接入自建认证代理；默认不保存凭据。只有用户在“首页 → 设置 → 学校账号”主动保存时，
         当前一个学校账号密码才用独立 Keystore alias 的 AES-GCM 密文写入 noBackup 目录；
         课表会话使用另一个独立 alias 加密，页面/组件不读取密码。
         存在校园卡组件时周期只读余额，课表自动更新只重绘本地缓存、不周期登录学校；
         明文网络只在 res/xml/network_security_config.xml 里对已核实主机放开。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 仅用于“检查更新 → 下载校验完成 → 用户在系统界面确认安装”。不静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        校园服务入口要在系统浏览器里打开，Android 11+ 必须显式声明可查询的 Intent。
        这里只声明 http/https 的浏览意图，查询范围最小。
    -->
    <queries>
        <!-- 仅用于用户主动选择的微信分享/启动，不查询全部安装应用。 -->
        <package android:name="com.tencent.mm" />
        <!-- 仅解析系统 APK 安装器；不会查询其他应用。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
        系统备份：**关掉**。

        README 承诺"数据只在本机、不上传"，而系统云备份由**操作系统**代劳上传，
        完全不经过本应用的网络栈 —— 没有 INTERNET 权限也拦不住。
        所以这里两道保险：
          · android:allowBackup="false"
          · 两份规则文件里逐域排除（覆盖某些 ROM 忽略 allowBackup 的情况，
            以及 Android 11 及以下走 fullBackupContent 的路径）
    -->
    <application
        android:name=".UpcPocketApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpcPocket">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.UpcPocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            桌面小组件：校园卡余额、唐岛湾剩余电量、今日课表与本机待办。

            所有组件接收器都 exported=false；APPWIDGET_UPDATE 由系统以显式广播投递。
            刷新动作只携带 appWidgetId；待办勾选的显式 Mutable PendingIntent 仅接收
            RemoteViews 的 checked 值，并由私有 receiver 校验 widget 与任务 revision。
            不携带学号、楼号、房间号或 URL。组件 updatePeriodMillis=0。
        -->
        <receiver
            android:name=".widget.CardBalanceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_card_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_balance_info" />
        </receiver>
        <receiver
            android:name=".widget.PowerWidgetProvider"
            android:exported="false"
            android:label="@string/widget_power_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_power_balance_info" />
        </receiver>
        <receiver
            android:name=".widget.TimetableWidgetProvider"
            android:exported="false"
            android:label="@string/widget_timetable_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_today_info" />
        </receiver>
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:exported="false"
            android:label="@string/widget_todo_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todo_info" />
        </receiver>
        <receiver
            android:name=".widget.CardBalanceGlassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_card_glass_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_card_balance_glass_info" />
        </receiver>
        <receiver
            android:name=".widget.PowerGlassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_power_glass_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_power_balance_glass_info" />
        </receiver>
        <receiver
            android:name=".widget.TimetableGlassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_timetable_glass_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timetable_today_glass_info" />
        </receiver>
        <receiver
            android:name=".widget.TodoGlassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_todo_glass_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_todo_glass_info" />
        </receiver>

        <!-- Mutable only for the system-filled RemoteViews checkbox state; the receiver is private. -->
        <receiver
            android:name=".widget.TodoWidgetCompleteReceiver"
            android:exported="false" />

        <!-- Protected system broadcasts only; keep private to the app and system. -->
        <receiver
            android:name=".widget.WidgetTimeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            诊断 ZIP 只能通过 FileProvider 的专用 cache 子目录临时授权读取。
            provider 不导出，不开放 root-path/files-path，也不申请存储权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_file_paths" />
        </provider>

        <!--
            更新 APK 使用独立 authority 与独立 FileProvider 配置，只暴露
            cache/updates/；诊断 provider 仍只暴露 diagnostic_exports/。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- 只接收本应用 PackageInstaller 会话的显式结果；不导出、无隐式 filter。 -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
