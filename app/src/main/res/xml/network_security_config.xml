<?xml version="1.0" encoding="utf-8"?>
<!--
    明文网络**只**对已核实的具体主机放开，其余一律要求 HTTPS。

    为什么要放开（2026-10-28 实测，不是猜测）：
      · dfcz.upc.edu.cn —— 唐岛湾用电查询系统只有 HTTP 入口，HTTPS 端口握手直接失败；
        查询本身是公开的“楼号＋房间号 → 剩余电量”，不带任何凭据。
      （轻量版第一步已移除课表：教务入口与 jwxt 主机的明文例外一并删除。
        第二步删除了校园卡平台登录与流水，mb-xyk 的登录回跳例外也不再需要。）

    其余学校站点（app / cas / i / libspace / gzkdf）保持 HTTPS 强制；
    古镇口 gzkdf 的证书已过期，这里**不**为它放开任何限制，也不允许绕过证书校验。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 用户提供并经本人测试的余额接口，只有 HTTP；学号与余额为明文传输。 -->
        <domain includeSubdomains="false">jhzf.upc.edu.cn</domain>
        <domain includeSubdomains="false">dfcz.upc.edu.cn</domain>
    </domain-config>
</network-security-config>
