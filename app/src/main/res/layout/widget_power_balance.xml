<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_power_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_glass_background" android:orientation="vertical" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/widget_power_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
   android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/widget_power_title"
   android:textColor="@color/widget_primary" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
  <ImageButton android:id="@+id/widget_power_refresh" android:layout_width="48dp" android:layout_height="48dp"
   android:background="@drawable/widget_refresh_background" android:contentDescription="@string/widget_refresh_power"
   android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/ic_widget_refresh" />
 </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:id="@+id/widget_power_building" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
 android:text="@string/widget_power_building_none" android:textColor="@color/widget_secondary" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
 <TextView android:id="@+id/widget_power_room" android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:text="@string/widget_power_room_none" android:textColor="@color/widget_primary" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
</LinearLayout>
<TextView android:id="@+id/widget_power_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp"
 android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_empty_value" android:textColor="@color/widget_primary" android:textSize="28sp" />
<TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no" />
<TextView android:id="@+id/widget_power_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="@string/widget_no_record" android:textColor="@color/widget_secondary" android:textSize="10sp" />
</LinearLayout>
