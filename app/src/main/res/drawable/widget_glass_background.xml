<?xml version="1.0" encoding="utf-8"?>
<!-- 半透明“玻璃”底：RemoteViews 无法保证实时模糊壁纸，这里用渐变 + 细描边做轻层次，
     不申请截屏/壁纸权限，也不用大位图假装模糊。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_card_fill_bottom"
        android:startColor="@color/widget_card_fill_top" />
    <stroke
        android:width="0.5dp"
        android:color="@color/widget_card_stroke" />
    <corners android:radius="20dp" />
</shape>
