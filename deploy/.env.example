# UPC Pocket 多用户 Web 服务 · 生产环境变量模板
#
# 用法（在仓库根）：
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   # 填写下方所有标注「必填」的项，再执行 compose
#
# 规则：
# - 本文件只含占位符，真实域名、密码、密钥私钥不得提交；deploy/.env 已被 .gitignore 忽略。
# - 敏感项留空，由部署者填写；带 __SET_ME__ 的字段表示必须替换。
# - app 读取同名环境变量；Caddy 只读取 PUBLIC_HOST。
# - 修改后执行 `docker compose -f deploy/docker-compose.yml up -d`（会重建 app）生效。

# ===== 基本 =====
# 生产固定为 production；非 production 不应在公网暴露。
ENV=production
# 必填：站点公开源。严格同源校验与 HSTS 依据，必须与 PUBLIC_HOST 一致，
# 使用 https:// 前缀，不带路径、端口或末尾斜杠。示例：https://upc-pocket.example.com
PUBLIC_ORIGIN=https://upc-pocket.example.com
# 必填：仅 Caddy 使用的站点域名（证书申请、自动 HTTP→HTTPS）。
# DNS A/AAAA 必须已指向本机公网地址，且 80/443 已放行；不能带协议和路径。
PUBLIC_HOST=upc-pocket.example.com

# ===== 静态资源 =====
# 生产由 Caddy 直接提供 /srv/web（宿主 ../web 只读挂载），app 不提供静态文件。
SERVE_STATIC=false
# 仅当 SERVE_STATIC=true 时 app 才使用的静态根目录（本地排查用，生产保持默认）。
WEB_ROOT=/srv/web

# ===== 上游协议模块 =====
# 镜像内 tools/web 的挂载位置，必须与 Dockerfile 的 COPY 目标一致。
UPSTREAM_PATH=/app/tools/web

# ===== 数据存储 =====
# 必填：PostgreSQL DSN。密码必须与下方 POSTGRES_PASSWORD 完全一致。
# 填法：postgresql://upcpocket:<密码>@db:5432/upcpocket
DATABASE_URL=
# 必填：Redis DSN。密码必须与下方 REDIS_PASSWORD 完全一致。
# 填法：redis://:<密码>@redis:6379/0
# 密码含 @ : / 等字符时必须做 URL 百分号编码，或直接使用 URL 安全随机字符。
REDIS_URL=
# app 启动时自动执行幂等迁移（server/migrations/001_init.sql）。保持 true。
DB_AUTO_MIGRATE=true

# ===== 登录密钥与数据密钥（Docker secrets / 只读挂载） =====
# 当前登录签名密钥编号。目录内需有 <kid>.pem；轮换流程见 deploy/README.md。
# 示例：2026-11；初始值由 server/scripts/generate_keys.py 的 --kid 决定。
LOGIN_KEY_ID=2026-11
# 登录密钥目录（目录内可同时保留新旧 kid）。compose 以只读方式挂载。
LOGIN_KEY_DIR=/run/secrets/login_keys
# 数据加密密钥文件（32 字节原始密钥）与版本号；轮换涉及数据迁移，见 README。
DATA_KEY_FILE=/run/secrets/data_key
DATA_KEY_VERSION=1
# 会话签名密钥文件；轮换它会让所有现有会话立即失效。
SESSION_SECRET_FILE=/run/secrets/session_secret

# ===== 业务开关 =====
# 学校接入模式：official（默认）= 只给官方入口，服务端不接收学校凭据；
# station = 站内登录/预约，只有取得学校授权且 ECS 能访问学校上游时才可开启。
SCHOOL_ACCESS_MODE=official
# 设为 false 并重建 app 即停用预约写入（只读查询不受影响），用于紧急关闭。
BOOKING_ENABLED=false
# 应用层限流；Caddy 不加载第三方限流插件。
RATE_LIMIT_ENABLED=true

# ===== 运行 =====
# 只信任 Caddy 传入的 X-Forwarded-*；app 未发布端口，不要改成 false 后直接暴露。
TRUST_PROXY=true
# uvicorn worker 数；按 CPU 与内存调整，默认 2。
WEB_CONCURRENCY=2
# DEBUG / INFO / WARNING / ERROR。生产用 INFO，不在日志打印请求体、响应或凭据。
LOG_LEVEL=INFO

# ===== compose 内部凭据（不进入 app 环境） =====
# 必填：PostgreSQL 超级用户密码；与 DATABASE_URL 中的密码一致。
# 建议 32 字节以上随机值，例如 `openssl rand -base64 32` 后取 URL 安全字符。
POSTGRES_PASSWORD=
# 必填：Redis 访问密码；与 REDIS_URL 中的密码一致。
# 建议同样 32 字节以上随机值。
REDIS_PASSWORD=

# ===== 备份 =====
# 必填：age 公钥（收件人），deploy/backup.sh 用它加密数据库备份。
# age 私钥必须离线保管，绝不能放在仓库、服务器可被服务进程读取的目录或本 .env 中。
# 生成：age-keygen -o ~/upcpocket-backup.key（公钥为 "age1..." 行）。
AGE_RECIPIENT=
